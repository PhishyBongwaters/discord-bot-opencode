DISCORD_BOT_TOKEN=1111111111111111aaaaaaaaaaaaaaaaaaaaaaaa
ALLOWED_USER_IDS=11111aaaaaa
# Role tiers (issue #5): admin > DJ > everyone. DJ_USER_IDS / DJ_ROLE_IDS /
# ADMIN_ROLE_IDS are comma-separated ids (default empty). ADMIN_USER_IDS
# defaults to ALLOWED_USER_IDS; with ALLOWED empty and this unset, tiers
# are disabled (open mode, preserves current behavior).
#DJ_USER_IDS=
#DJ_ROLE_IDS=
#ADMIN_USER_IDS=
#ADMIN_ROLE_IDS=
DEFAULT_DISCORD_CHANNEL=11111222aaaaaa
OPENCODE_BIN=path/to/opencode
OPENCODE_DIR=path/to/workdir
# FILE_JAIL allowlist root for drop targets + send sources
# (empty/unset = fail closed to OPENCODE_DIR; no unlimited mode)
FILE_JAIL=
OPENCODE_MODEL=
OPENCODE_AGENT=
OPENCODE_AUTO=1
OPENCODE_TIMEOUT=600
MAX_CONCURRENT_TURNS=2
STATE_FILE=state/sessions.json
GUILD_PREFIX=!oc
ATTACH_DIR=attachments
MAX_ATTACH_MB=25
ATTACH_KEEP_FILES=50
ATTACH_KEEP_MB=500
LOG_LEVEL=INFO
REPLY_AS_FILE_LIMIT=4000
REACT_START=⏳
REACT_DONE=✅
REACT_ERROR=❌
VOICEBOX_URL=http://127.0.0.1:17493
VOICEBOX_PROFILE=Computer
VOICEBOX_VOICE=1
VOICEBOX_TIMEOUT=120
VOICEBOX_MAX_CHARS=1200
VOICEBOX_CACHE_DIR=tts_cache
VOICEBOX_CACHE_FILES=500
VOICEBOX_CACHE_MB=200
VC_CHUNK_CHARS=400
VOICEBOX_TRANSCRIBE=1
VOICEBOX_STT_MODEL=
VOICEBOX_LANGUAGE=
SAY_DIR=say_queue
SAY_POLL=2.0
SAY_MAX_BYTES=8192
TEXT_DIR=text_queue
TEXT_POLL=2.0
TEXT_MAX_BYTES=4000
TEXT_MAX_PER_MINUTE=10
# VC_AUTOJOIN=voice-channel-id
VC_AUTOREJOIN=1
VC_AUTOLEAVE_MINUTES=5
VOICEBOX_WARMUP=1
VOICE_USER_ID=
FFMPEG_BIN=ffmpeg
# Video thumbnails: still frames extracted per inbound video via --file
VIDEO_THUMB_FRAMES=4
VIDEO_THUMB_EVERY_S=5
VIDEO_THUMB_MAX_MB=200
# OPUS_LIB=path/to/libopus-0.x64.dll
